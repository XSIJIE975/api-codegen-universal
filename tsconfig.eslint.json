{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "customConditions": ["source"]
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "packages/*/*.config.ts",
    "packages/*/*.config.mjs"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/dist",
    "**/.rslib",
    "packages/*/.rslib/**"
  ]
}
